{
  "https://novelphoenix.com/novel/*": {
    "name": "NovelPhoenix",
    "alwaysHidden": [
      ".nf-ads",
      ".box-notification",
      ".box-notice",
      ".report-container",
      "footer"
    ],
    "topUI": [
      "header.main-header",
      "#chapter-article .titles",
      "#chapter-article .chapternav:not(.py-3)"
    ],
    "comments": [
      "#chapter-comments"
    ]
  },
  "https://novelfire.net/book/*": {
    "name": "NovelFire",
    "alwaysHidden": [
      ".nf-ads",
      ".box-notice",
      ".report-container",
      "#chapter-container > div:has(iframe)",
      "footer"
    ],
    "topUI": [
      "header.main-header",
      "#chapter-article .titles",
      "#chapter-article .chapternav:not(.py-3)",
      ".navbar-breadcrumb"
    ],
    "comments": [
      "#chapter-comments"
    ]
  }
}
